# ==============================================================================
# Learn Me - Production & Local Environment Configuration Template
# ==============================================================================

# Node Environment ('development', 'test', 'production')
NODE_ENV=development

# Supabase Authentication Configuration
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Backend REST API Port
PORT=5000

# Database Configuration
# For local development: DB_DIALECT=sqlite (uses backend/data/learnme.sqlite)
# For production cloud database (Neon, Supabase, Render, Railway, AWS RDS):
# Provide the complete PostgreSQL connection string:
DATABASE_URL=
DB_DIALECT=sqlite
DB_SSL=true

# Manual Database Parameters (when DATABASE_URL is not used)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=learnme
DB_USER=postgres
DB_PASSWORD=

# JWT Secrets (Generate secure 64-character random strings in production)
JWT_SECRET=learn_me_super_secret_jwt_key_2026_production_grade
JWT_REFRESH_SECRET=learn_me_super_secret_refresh_key_2026

# Frontend Website URLs (For CORS Origin Whitelisting)
STUDENT_WEB_URL=http://localhost:3000
ADMIN_WEB_URL=http://localhost:3001

# Additional comma-separated origins for production deployments
# Example: CORS_ORIGINS=https://learnme.example.com,https://admin.learnme.example.com
CORS_ORIGINS=

# Default Owner Admin Credentials (Created automatically on initial database seed)
ADMIN_INITIAL_PASSWORD=Sumathi@12345
